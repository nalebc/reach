{
  "name": "reach-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your devices, within reach. A private mobile workspace for your computers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "go": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "pair": "node scripts/pair.mjs",
    "share": "node scripts/share.mjs",
    "install-service": "node scripts/service.mjs install",
    "uninstall-service": "node scripts/service.mjs uninstall",
    "package": "node scripts/package.mjs",
    "agent-token": "node scripts/agent-token.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "mcp": "node scripts/mcp.mjs",
    "format": "prettier --write src server scripts test docs README.md package.json vite.config.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "prompts": "2.4.2",
    "qrcode-terminal": "0.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^6.4.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "bin": {
    "reach-agent": "scripts/agent-cli.mjs"
  }
}
