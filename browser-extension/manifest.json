{
  "manifest_version": 3,
  "name": "Reach",
  "short_name": "Reach",
  "version": "0.2.0",
  "description": "Runs the saved browser tools your Reach agents use, in your own browser, for the Reach app on this computer only.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["nativeMessaging", "scripting", "storage", "alarms"],
  "host_permissions": ["https://*/*"],
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/reach-16.png",
    "32": "icons/reach-32.png",
    "48": "icons/reach-48.png",
    "128": "icons/reach-128.png"
  }
}
