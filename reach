#!/bin/sh
# One entry point; a missing Node runtime is installed privately, without sudo.
set -eu
# Run through a link (the `reach` command, from ./reach cli): the real folder.
SELF=$0
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in
    /*) SELF=$LINK ;;
    *) SELF=$(dirname -- "$SELF")/$LINK ;;
  esac
done
REACH_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
# Hints then say `reach …`, as typed.
if [ "$SELF" != "$0" ]; then
  REACH_COMMAND=reach
  export REACH_COMMAND
fi
PRIVATE_RUNTIME=0
for ARG in "$@"; do
  case "$ARG" in install|--background) PRIVATE_RUNTIME=1 ;; esac
done
if [ "$PRIVATE_RUNTIME" = 1 ]; then
  REACH_INSTALL_PATH=$PATH
  export REACH_INSTALL_PATH
fi
# Reach running in this window starts again here when it stopped by itself
# (server/crash-guard.mjs exits 70; 134 is Node out of memory), so a crash
# while you're away is a short drop, not a dead Mac: after 1, 5, 15, then 30
# seconds, at most 5 times in 10 minutes. Same window, same Screen Recording
# and Accessibility. Ctrl+C, ./reach stop, a closed window and errors Reach
# reported itself end it. Other commands and the background service (launchd
# starts it again) run once, as before.
run_reach() {
  NODE_BIN=$1
  shift
  case "${1:-}" in
    "" | -* | restart) ;;
    *) exec "$NODE_BIN" "$REACH_DIR/scripts/bootstrap.mjs" "$@" ;;
  esac
  for ARG in "$@"; do
    case "$ARG" in
      --service | --background | --stop-background | --help | -h | --version | -v)
        exec "$NODE_BIN" "$REACH_DIR/scripts/bootstrap.mjs" "$@" ;;
    esac
  done
  REACH_SUPERVISED=1
  export REACH_SUPERVISED
  STARTS=""
  while :; do
    CODE=0
    "$NODE_BIN" "$REACH_DIR/scripts/bootstrap.mjs" "$@" || CODE=$?
    case "$CODE" in
      70 | 134) ;;
      *) exit "$CODE" ;;
    esac
    NOW=$(date +%s)
    RECENT=""
    COUNT=0
    for T in $STARTS; do
      if [ $((NOW - T)) -lt 600 ]; then
        RECENT="$RECENT $T"
        COUNT=$((COUNT + 1))
      fi
    done
    if [ "$COUNT" -ge 5 ]; then
      echo "Reach stopped unexpectedly 5 times in 10 minutes, so it isn't starting again by itself. What happened is in crash.log in Reach's data folder (.reach/quick). Run ./reach to start it." >&2
      exit "$CODE"
    fi
    STARTS="$RECENT $NOW"
    case "$COUNT" in
      0) DELAY=1 ;;
      1) DELAY=5 ;;
      2) DELAY=15 ;;
      *) DELAY=30 ;;
    esac
    echo "Reach: starting again in ${DELAY}s…"
    sleep "$DELAY"
    # It starts Reach again; what a restart stops is already stopped.
    FIRST=1
    for ARG do
      if [ "$FIRST" = 1 ]; then
        set --
        FIRST=0
      fi
      case "$ARG" in
        restart | --yes) ;;
        *) set -- "$@" "$ARG" ;;
      esac
    done
  done
}
if [ "$PRIVATE_RUNTIME" = 0 ] && command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' 2>/dev/null; then
  run_reach node "$@"
fi
VERSION=22.23.3
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) TARGET=darwin-arm64; SHA=23b25245dcfb9af7262f8ff142e9e2e0af025368117329e7a7458a51e5922f53 ;;
  Darwin-x86_64) TARGET=darwin-x64; SHA=8a677b0219178efd6eb0e475457c4afb452b521a92f6e67845a73bd85727f2a8 ;;
  Linux-aarch64|Linux-arm64) TARGET=linux-arm64; SHA=5ced2d48d1d7198739b7f86804de0171aefb6823b684b12341d3321afc3cb0b2 ;;
  Linux-x86_64) TARGET=linux-x64; SHA=1084aa36196bba4c3a5e69a1ee388a6e4ff729dad09445fbcd434b28fe3c24af ;;
  *) echo 'Reach supports Mac, Windows x64, and Linux x64/arm64.' >&2; exit 1 ;;
esac
CACHE="$REACH_DIR/.reach/runtime"
RUNTIME="$CACHE/node-v$VERSION-$TARGET"
if [ ! -x "$RUNTIME/bin/node" ]; then
  mkdir -p "$CACHE"
  chmod 700 "$REACH_DIR/.reach" "$CACHE"
  STAGE=$(mktemp -d "$CACHE/download.XXXXXX")
  trap 'rm -rf "$STAGE"' EXIT HUP INT TERM
  echo 'Reach: preparing a private Node.js runtime (first run only)…'
  curl --fail --location --proto '=https' --proto-redir '=https' --retry 2 --connect-timeout 20 --max-time 300 \
    "https://nodejs.org/dist/v$VERSION/node-v$VERSION-$TARGET.tar.gz" -o "$STAGE/node.tar.gz"
  if command -v shasum >/dev/null 2>&1; then
    ACTUAL=$(shasum -a 256 "$STAGE/node.tar.gz" | cut -d ' ' -f 1)
  else
    ACTUAL=$(sha256sum "$STAGE/node.tar.gz" | cut -d ' ' -f 1)
  fi
  [ "$ACTUAL" = "$SHA" ] || { echo 'Node.js checksum mismatch; stopping.' >&2; exit 1; }
  tar -xzf "$STAGE/node.tar.gz" -C "$STAGE"
  mv "$STAGE/node-v$VERSION-$TARGET" "$RUNTIME"
  rm -rf "$STAGE"
  trap - EXIT HUP INT TERM
fi
PATH="$RUNTIME/bin:$PATH"
export PATH
run_reach "$RUNTIME/bin/node" "$@"
